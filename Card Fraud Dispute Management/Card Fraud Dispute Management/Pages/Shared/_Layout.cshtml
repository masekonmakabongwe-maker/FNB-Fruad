<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Card Fraud Dispute Management · Purple Fabric</title>
    <link rel="icon" type="image/png" href="~/img/purple-fabric-logo.png?v=3">
    <link rel="alternate icon" href="~/favicon.ico?v=3">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <script>
        // Applied before the stylesheet paints anything, so switching themes
        // between visits doesn't flash the old theme for a frame first.
        (function () {
            try {
                var saved = localStorage.getItem('cfd-theme');
                if (saved === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
            } catch (e) { }
        })();
    </script>
</head>
<body>
    @RenderBody()
    <footer class="app-footer" id="appFooter">
        <div class="footer-left"><img src="~/img/purple-fabric-logo.png" alt="Purple Fabric" class="logo-mark" /><b>PURPLE FABRIC</b></div>
        <div class="footer-mid">
            <a href="#">Documentation</a>
            <a href="#">Governance overlay</a>
            <a href="#">Model &amp; data policy</a>
            <a href="#">Support</a>
        </div>
        <div class="footer-right">Card Fraud Dispute Management · Copyright © 2026,IntellectDesign Arena Ltd  </div>
    </footer>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>